# Local development uses SQLite automatically when DATABASE_URL is omitted.
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173

# Password recovery. Use a long random value in production.
PASSWORD_RESET_SECRET=replace-with-a-long-random-secret
# BREVO_API_KEY=xkeysib-xxxxxxxxx
# EMAIL_FROM=your-verified-sender@example.com
# EMAIL_FROM_NAME=CivicFlow

# Hosted production example:
# NODE_ENV=production
# APP_ORIGIN=https://your-civicflow-domain.example
# PUBLIC_APP_URL=https://your-civicflow-domain.example
# DATABASE_URL=postgresql://user:password@host:5432/civicflow
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
